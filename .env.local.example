# =============================================
# VARIÁVEIS DE AMBIENTE — ALBERGUE SVP
# =============================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA suba o arquivo .env.local para o Git.

# Supabase (Frente 1 — Núcleo de Dados)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Se setado para "true", o site usa os dados de placeholder em vez do banco real (modo dev offline).
# NEXT_PUBLIC_USE_MOCK=true

# Chave Pix do Albergue (preenchida pela equipe de Campo)
NEXT_PUBLIC_PIX_KEY=

# Link do WhatsApp Business do Albergue
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/55XXXXXXXXXXX

# Google Maps — ID do mapa embedado
NEXT_PUBLIC_MAPS_EMBED_ID=
